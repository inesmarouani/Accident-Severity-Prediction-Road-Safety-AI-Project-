    "def lister_colonnes(fichiers, sep=\";\"):\n",
    "    colonnes_par_fichier = {}\n",
    "\n",
    "    for f in fichiers:\n",
    "        df = pd.read_csv(f, sep=sep)\n",
    "        colonnes_par_fichier[f] = list(df.columns)\n",
    "\n",
    "    return colonnes_par_fichier\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "ed2ca029-3416-47ce-b864-5df7dcffd12e",
   "metadata": {},
   "outputs": [],
   "source": [
    "def charger_fichiers(fichiers, sep=\";\"):\n",
    "\n",
    "    dfs = []\n",
    "\n",
    "    for f in fichiers:\n",
    "        df = pd.read_csv(f, sep=sep)\n",
    "        dfs.append(df)\n",
    "\n",
    "    return pd.concat(dfs, join = \"inner\")\n"
   ]
  },
