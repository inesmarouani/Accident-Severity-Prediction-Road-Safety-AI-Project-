   "source": [
    "datasets = {\n",
    "    \"Usagers\": usagers_all,\n",
    "    \"Véhicules\": vehicules_all,\n",
    "    \"Lieux\": lieux_all,\n",
    "    \"Caractéristiques\": caract_all\n",
    "}\n",
    "\n",
    "for nom, df in datasets.items():\n",
    "    # Matrice des valeurs manquantes\n",
    "    plt.figure(figsize=(14, 8))\n",
    "    msn.matrix(df, fontsize=12, sparkline=True)\n",
    "    plt.title(\n",
    "        f\"Matrice des Valeurs Manquantes — {nom}\",\n",
    "        fontsize=16,\n",
    "        fontweight=\"bold\",\n",
    "        pad=20\n",
    "    )\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "    # Statistiques des valeurs manquantes\n",
    "    missing_stats = pd.DataFrame({\n",
    "        \"Nombre_Missing\": df.isnull().sum(),\n",
    "        \"Pourcentage_Missing\": (df.isnull().sum() / len(df) * 100).round(2)\n",
    "    }).sort_values(\"Pourcentage_Missing\", ascending=False)\n",
    "\n",
    "    print(f\"\\n📊 Statistiques des Valeurs Manquantes — {nom}:\\n\")\n",
    "    display(missing_stats[missing_stats[\"Nombre_Missing\"] > 0])\n",
    "\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "63bcc00b-06dd-4d5c-b3b9-56c71930641a",
   "metadata": {},
   "source": [
    "### **Removing Highly Missing Columns (>70%)**\n",
    "\n",
    "Only columns with **≥30% of data present** are kept. Columns that are too sparse do not provide useful information.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "id": "ce7f9e53-9bb3-42e3-8213-04f3cfc546c6",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "Traitement du dataset : Usagers\n",
      "  Colonne supprimée : secu3 (96.61% de valeurs manquantes)\n",
      "  Colonne supprimée : etatp (92.27% de valeurs manquantes)\n",
      "\n",
      "Traitement du dataset : Véhicules\n",
      "  Colonne supprimée : occutc (99.11% de valeurs manquantes)\n",
      "\n",
      "Traitement du dataset : Lieux\n",
      "  Colonne supprimée : v2 (91.28% de valeurs manquantes)\n",
      "  Colonne supprimée : lartpc (99.92% de valeurs manquantes)\n",
      "\n",
      "Traitement du dataset : Caractéristiques\n"
     ]
    }
   ],
   "source": [
    "# Boucle sur chaque dataset\n",
    "for nom, df in datasets.items():\n",
    "    print(f\"\\nTraitement du dataset : {nom}\")\n",
    "\n",
    "    # Récupération des colonnes\n",
    "    colonnes = df.columns.tolist()\n",
    "\n",
    "    # Vérification des colonnes avec plus de 70% de valeurs manquantes\n",
    "    for col in colonnes:\n",
    "        taux_missing = df[col].isnull().sum() / len(df) * 100\n",
    "        if taux_missing > 70:\n",
    "            df.drop(columns=[col], inplace=True)\n",
    "            print(f\"  Colonne supprimée : {col} ({taux_missing:.2f}% de valeurs manquantes)\")\n",
    "\n"
   ]
  },
